{
    "manifest_version": 3,
    "name": "catguessr",
    "version": "0.5",
    "description": "Enhance your GeoGuessr experience",
    "devtools_page": "devtools/devtools.html",
    "icons": {
        "128": "assets/cat.png"
    },
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "webRequest",
        "storage"
    ],
    "host_permissions": [
        "https://www.geoguessr.com/"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.openstreetmap.org"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/pin.png",
                "assets/view.png"
            ],
            "matches": [
                "https://www.geoguessr.com/*"
            ]
        },
        {
            "world": "MAIN",
            "resources": [
                "xhr_inject.js"
            ],
            "matches": [
                "https://www.geoguessr.com/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "world": "MAIN",
            "matches": [
                "https://www.geoguessr.com/*"
            ],
            "js": [
                "xhr_inject.js",
                "main.js"
            ],
            "all_frames": true,
            "run_at": "document_end"
        }
    ]
}
